GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES

HAVE_DOT               = YES
DOT_PATH               = "C:/Program Files/Graphviz/bin"
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
GRAPHICAL_HIERARCHY    = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
UML_LOOK               = YES
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES

USE_MATHJAX            = YES
IMAGE_PATH             = docs/images
INPUT_ENCODING         = UTF-8
GENERATE_TIMESTAMP     = NO
FULL_SIDEBAR           = NO
SEARCHENGINE           = YES

ALIASES                = "note=@par Примечание:"
